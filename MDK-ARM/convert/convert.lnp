"convert\stm32f1xx_hal_gpio_ex.o"
"convert\stm32f1xx_hal_adc.o"
"convert\stm32f1xx_hal_adc_ex.o"
"convert\stm32f1xx_hal.o"
"convert\stm32f1xx_hal_rcc.o"
"convert\stm32f1xx_hal_rcc_ex.o"
"convert\stm32f1xx_hal_gpio.o"
"convert\stm32f1xx_hal_dma.o"
